# Workshop identity for netlab-dev, picked up by dojo.
# A minimal pack that runs the netlab module (modules/netlab) while it is built; the real
# workshop (slides, FACILITATOR.md, achievements) is a follow-up listed in ROADMAP.md.
WORKSHOP_NAME="Netlab (dev)"
WORKSHOP_DESCRIPTION="Per-student Ansible practice networks: a firewall, a VLAN switch and a web server, by hand and by playbook."
WORKSHOP_ORDER=90
WORKSHOP_DURATION="~3 h"
WORKSHOP_CONTENT_DIR=../workshops/netlab-dev/content
FORGEJO_ORG=training
FORGEJO_REPO=netlab
COMPOSE_OVERLAY=
MODULES="netlab"
STUDENT_COUNT=3
