# Workshop identity for srx-terraform, picked up by dojo.
# Paths are relative to engine/ (the compose base file's directory; see workshops/README.md for why).
WORKSHOP_NAME="SRX with Terraform and Mist"
WORKSHOP_DESCRIPTION="Build a greenfield Juniper SRX estate in Mist with HashiCorp Terraform and the real Juniper/mist provider, against a simulator."
WORKSHOP_TRACK=technology   # bucket in ./dojo list: education, offensive or technology
WORKSHOP_ORDER=1   # position in the track; ./dojo list sorts by it
WORKSHOP_DURATION="~2¾ h"   # how long a session takes, shown by ./dojo list; keep it in step with FACILITATOR.md
WORKSHOP_CONTENT_DIR=../workshops/srx-terraform/content
FORGEJO_ORG=netops
FORGEJO_REPO=srx-terraform
# Lab 0 has each student fork netops/srx-terraform and work in the fork; demo bots (--test) do the
# same. See engine/web-terminal/bot-runner.sh.
FORGEJO_FORK_WORKFLOW=1

# Terraform, the offline juniper/mist provider mirror and each student's Dojo WAN login come from the
# wan-cloud module. compose/terminal/ only adds `dojo prep` and `dojo check`. No compose overlay.
MODULES="lab-prep wan-cloud sensei feedback"
