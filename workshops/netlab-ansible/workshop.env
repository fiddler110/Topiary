# Workshop identity for netlab-ansible, picked up by dojo.
# Paths are relative to engine/ (see workshops/README.md).
WORKSHOP_NAME="Ansible on a Small Network"
WORKSHOP_DESCRIPTION="Learn Ansible by building a small network twice: a firewall, a VLAN switch and a web server, by hand and then by playbook."
WORKSHOP_ORDER=7   # position in the learning path (0 = showcase); ./dojo list sorts by it
WORKSHOP_DURATION="~3 h"   # keep in step with FACILITATOR.md
WORKSHOP_CONTENT_DIR=../workshops/netlab-ansible/content
FORGEJO_ORG=training
FORGEJO_REPO=netlab
COMPOSE_OVERLAY=

# netlab: one pod per student (pc, switch, firewall, web; branch m by hand and branch a by playbook) plus the
# facilitator's pod 00. The module caps the class at NETLAB_MAX_STUDENTS (15): 8 containers per student, and a
# rootless podman host stops near 200 containers. The achievements module is added by ACHIEVEMENTS_ENABLED.
MODULES="netlab"
STUDENT_COUNT=12
