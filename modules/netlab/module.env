# netlab module defaults; a workshop.env overrides them (README.md).

# Hard cap on STUDENT_COUNT: the generator refuses more. Each student runs 8 containers (6 without the switch), and a
# rootless podman host stops near 200 containers (kernel.keys.maxkeys, one key each); see NETLAB-PLAN.md section 9.1.
NETLAB_MAX_STUDENTS=15
# 1: each branch is pc - switch - firewall - web with VLANs 10 and 20 (router-on-a-stick). 0: flat pc - firewall - web.
NETLAB_SWITCH=1
# 1: every student gets a hand-configured branch (m) and an automated one (a). 0: the automated branch only.
NETLAB_MANUAL_BRANCH=1
# The pods' data networks are /29s carved from here. Must not overlap anything on the host.
NETLAB_DATA_NET=10.81.0.0/16

# Read-only proof for the achievements service (its netlab_labs_passed verb): POST /proof on netlab-checker answers only
# with this token, and says which labs the checker itself last saw pass on a student's pod. Derived from this install's
# GATEWAY_TOKEN (.env), never in the repo, and passed to no student-facing container.
NETLAB_PROOF_TOKEN="$(printf 'netlab/proof:%s' "${GATEWAY_TOKEN:-}" | sha256sum | cut -c1-40)"
ACHIEVEMENTS_NETLAB_CHECKER_URL=http://netlab-checker:8080

# modules/_shared/ files this module's services import, copied into <folder>/_shared/ by ./dojo.
SHARED="netlab-view/dojo_http.py"
