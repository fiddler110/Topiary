# System-wide Terraform CLI config (root-owned; students cannot edit it).
# The lab network has no internet, so providers come only from the mirror
# baked into the image at /opt/terraform-providers.
provider_installation {
  filesystem_mirror {
    path    = "/opt/terraform-providers"
    include = ["registry.terraform.io/*/*"]
  }
  direct {
    exclude = ["registry.terraform.io/*/*"]
  }
}
