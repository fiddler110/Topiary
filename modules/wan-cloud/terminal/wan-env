#!/usr/bin/env python3
"""Prints `export NAME='value'` lines with the calling user's Dojo WAN
credentials, fetched from the root-owned broker. Silent no-op if the broker (or
wan-api) isn't available. Used from /etc/zsh/zshenv:  eval "$(wan-env)"
"""
import json
import shlex
import socket
import sys

try:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(2)
    s.connect("/run/wan-broker/broker.sock")
    data = b""
    while True:
        chunk = s.recv(65536)
        if not chunk:
            break
        data += chunk
    for name, value in json.loads(data or b"{}").items():
        print(f"export {name}={shlex.quote(value)}")
except (OSError, ValueError):
    sys.exit(0)
